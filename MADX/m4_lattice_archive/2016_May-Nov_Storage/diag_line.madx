beam,    sequence=M4line, particle="proton", energy=8.93828;

roton=1;
ECMAG_srot =-0.00004982;!March 21 2016 
call, file="m4.def";
!overwrite HDA1 def
hda1_angle=-0.0873;
hda1_l= hda1_angle*0.5*1.524/sin(hda1_angle*0.5);!=1.52448406
HDA1  : rbend, l:=hda1_l, angle:=hda1_angle;
call, file="diag.seq";
call, file="quads_all.dat";

!Steve March 21
newstart: beta0, betx=12.22350,
                 alfx=1.88239, 
                 bety=5.61627, 
                 alfy=-0.61825,
                 dx=0.02765,dpx=0.00346,
                 dy=-0.12410,
                 dpy=-0.07144;

use, sequence= M4line;
select, flag=twiss, clear;
set,    format="14.8f";
select,  flag=twiss, column=name,s,betx,alfx,bety,alfy,dx,dpx,dy,dpy,keyword,l,angle,k1l;
twiss,chrom,beta0=newstart,sequence=M4line,file="diag_twiss.tfs";

hda1_angle=-0.0873;
set,    format="14.8f";
!Steve, March 21 2016
survey,file="diag_survey.tfs",Z0=30446.932608,
                         X0=30071.579367,
                         Y0=222.115867,
                         theta0=2.090464,
                         phi0=0.056064;
stop;
HDA1k: hkicker, l=1.524, kick=0.087;
SEQEDIT, SEQUENCE = M4line;
replace, element = HDA1, by=HDA1k;
FLATTEN; 
ENDEDIT;

use, sequence= M4line;
select, flag=twiss, clear;
set,    format="14.8f";
select,  flag=twiss, column=name,s,x,y,keyword,l,angle,k1l;
twiss,chrom,beta0=newstart,sequence=M4line,file="trajectory.tfs";

stop;
