//##############################################################################
// Magnet Strength Functions
//##############################################################################

// Main quadrupole magnet normalized gradients. [1/m^2]
G_DQ303 = F_DQ303 * F_LQE * (C0_LQE + C1_LQE * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT303 * I_DQT303) + C2_LQE * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT303 * I_DQT303)^2 + C3_LQE * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT303 * I_DQT303)^3) * E_LIGHT / (1E+09 * L_LQE * E_MOMENTUM);
G_DQ302 = F_DQ302 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS302 * I_DQS302) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS302 * I_DQS302)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS302 * I_DQS302)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ301 = F_DQ301 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS301 * I_DQS301) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS301 * I_DQS301)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS301 * I_DQS301)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ202 = F_DQ202 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS202 * I_DQS202) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS202 * I_DQS202)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS202 * I_DQS202)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ203 = F_DQ203 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS203 * I_DQS203) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS203 * I_DQS203)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS203 * I_DQS203)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ204 = F_DQ204 * F_SQC * (C0_SQC + C1_SQC * (FI_DQSS * I_DQSS - FI_DQS204 * I_DQS204) + C2_SQC * (FI_DQSS * I_DQSS - FI_DQS204 * I_DQS204)^2 + C3_SQC * (FI_DQSS * I_DQSS - FI_DQS204 * I_DQS204)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ205 = F_DQ205 * F_B8Q24 * (C0_B8Q24 + C1_B8Q24 * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT205 * I_DQT205) + C2_B8Q24 * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT205 * I_DQT205)^2 + C3_B8Q24 * (FI_DIBQ * I_DIBQ + FI_DIBD * I_DIBD + FI_DQT205 * I_DQT205)^3) * E_LIGHT / (1E+09 * L_B8Q24 * E_MOMENTUM);
G_DQ901 = F_DQ901 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ901 * I_DQ901) + C2_SQA * (FI_DQ901 * I_DQ901)^2 + C3_SQA * (FI_DQ901 * I_DQ901)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ902 = F_DQ902 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ902 * I_DQ902) + C2_SQD * (FI_DQ902 * I_DQ902)^2 + C3_SQD * (FI_DQ902 * I_DQ902)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ903 = F_DQ903 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ903 * I_DQ903) + C2_SQD * (FI_DQ903 * I_DQ903)^2 + C3_SQD * (FI_DQ903 * I_DQ903)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ904 = F_DQ904 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ904 * I_DQ904) + C2_SQD * (FI_DQ904 * I_DQ904)^2 + C3_SQD * (FI_DQ904 * I_DQ904)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ905 = F_DQ905 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ905 * I_DQ905) + C2_SQA * (FI_DQ905 * I_DQ905)^2 + C3_SQA * (FI_DQ905 * I_DQ905)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ906 = F_DQ906 * F_SQC * (C0_SQC + C1_SQC * (FI_DQ906 * I_DQ906) + C2_SQC * (FI_DQ906 * I_DQ906)^2 + C3_SQC * (FI_DQ906 * I_DQ906)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ907 = F_DQ907 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ907 * I_DQ907) + C2_SQD * (FI_DQ907 * I_DQ907)^2 + C3_SQD * (FI_DQ907 * I_DQ907)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ908 = F_DQ908 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ908 * I_DQ908) + C2_SQA * (FI_DQ908 * I_DQ908)^2 + C3_SQA * (FI_DQ908 * I_DQ908)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ909 = F_DQ909 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ909 * I_DQ909) + C2_SQA * (FI_DQ909 * I_DQ909)^2 + C3_SQA * (FI_DQ909 * I_DQ909)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ910 = F_DQ910 * F_SQC * (C0_SQC + C1_SQC * (FI_DQ910 * I_DQ910) + C2_SQC * (FI_DQ910 * I_DQ910)^2 + C3_SQC * (FI_DQ910 * I_DQ910)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ911 = F_DQ911 * F_SQC * (C0_SQC + C1_SQC * (FI_DQ911 * I_DQ911) + C2_SQC * (FI_DQ911 * I_DQ911)^2 + C3_SQC * (FI_DQ911 * I_DQ911)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ912 = F_DQ912 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ912 * I_DQ912) + C2_SQA * (FI_DQ912 * I_DQ912)^2 + C3_SQA * (FI_DQ912 * I_DQ912)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ913 = F_DQ913 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ913 * I_DQ913) + C2_SQD * (FI_DQ913 * I_DQ913)^2 + C3_SQD * (FI_DQ913 * I_DQ913)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ914 = F_DQ914 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ914 * I_DQ914) + C2_SQD * (FI_DQ914 * I_DQ914)^2 + C3_SQD * (FI_DQ914 * I_DQ914)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ915 = F_DQ915 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ914 * I_DQ914) + C2_SQD * (FI_DQ914 * I_DQ914)^2 + C3_SQD * (FI_DQ914 * I_DQ914)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ916 = F_DQ916 * F_SQD * (C0_SQD + C1_SQD * (FI_DQ913 * I_DQ913) + C2_SQD * (FI_DQ913 * I_DQ913)^2 + C3_SQD * (FI_DQ913 * I_DQ913)^3) * E_LIGHT / (1E+09 * L_SQD * E_MOMENTUM);
G_DQ917 = F_DQ917 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ912 * I_DQ912) + C2_SQA * (FI_DQ912 * I_DQ912)^2 + C3_SQA * (FI_DQ912 * I_DQ912)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ918 = F_DQ918 * F_SQC * (C0_SQC + C1_SQC * (FI_DQ911 * I_DQ911) + C2_SQC * (FI_DQ911 * I_DQ911)^2 + C3_SQC * (FI_DQ911 * I_DQ911)^3) * E_LIGHT / (1E+09 * L_SQC * E_MOMENTUM);
G_DQ919 = F_DQ919 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ919 * I_DQ919) + C2_SQA * (FI_DQ919 * I_DQ919)^2 + C3_SQA * (FI_DQ919 * I_DQ919)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ920 = F_DQ920 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ919 * I_DQ919) + C2_SQA * (FI_DQ919 * I_DQ919)^2 + C3_SQA * (FI_DQ919 * I_DQ919)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ921 = F_DQ921 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ919 * I_DQ919) + C2_SQA * (FI_DQ919 * I_DQ919)^2 + C3_SQA * (FI_DQ919 * I_DQ919)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ922 = F_DQ922 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ919 * I_DQ919) + C2_SQA * (FI_DQ919 * I_DQ919)^2 + C3_SQA * (FI_DQ919 * I_DQ919)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ923 = F_DQ923 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ919 * I_DQ919) + C2_SQA * (FI_DQ919 * I_DQ919)^2 + C3_SQA * (FI_DQ919 * I_DQ919)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ924 = F_DQ924 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ924 * I_DQ924) + C2_SQA * (FI_DQ924 * I_DQ924)^2 + C3_SQA * (FI_DQ924 * I_DQ924)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ925 = F_DQ925 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ925 * I_DQ925) + C2_SQA * (FI_DQ925 * I_DQ925)^2 + C3_SQA * (FI_DQ925 * I_DQ925)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ926 = F_DQ926 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ926 * I_DQ926) + C2_SQA * (FI_DQ926 * I_DQ926)^2 + C3_SQA * (FI_DQ926 * I_DQ926)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ927 = F_DQ927 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ927 * I_DQ927) + C2_SQA * (FI_DQ927 * I_DQ927)^2 + C3_SQA * (FI_DQ927 * I_DQ927)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ928 = F_DQ928 * F_SQB * (C0_SQB + C1_SQB * (FI_DQ928 * I_DQ928) + C2_SQB * (FI_DQ928 * I_DQ928)^2 + C3_SQB * (FI_DQ928 * I_DQ928)^3) * E_LIGHT / (1E+09 * L_SQB * E_MOMENTUM);
G_DQ929 = F_DQ929 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ929 * I_DQ929) + C2_SQA * (FI_DQ929 * I_DQ929)^2 + C3_SQA * (FI_DQ929 * I_DQ929)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ930 = F_DQ930 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ930 * I_DQ930) + C2_SQA * (FI_DQ930 * I_DQ930)^2 + C3_SQA * (FI_DQ930 * I_DQ930)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ931 = F_DQ931 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ931 * I_DQ931) + C2_SQA * (FI_DQ931 * I_DQ931)^2 + C3_SQA * (FI_DQ931 * I_DQ931)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ932 = F_DQ932 * F_SQA * (C0_SQA + C1_SQA * (FI_DQ932 * I_DQ932) + C2_SQA * (FI_DQ932 * I_DQ932)^2 + C3_SQA * (FI_DQ932 * I_DQ932)^3) * E_LIGHT / (1E+09 * L_SQA * E_MOMENTUM);
G_DQ933 = F_DQ933 * F_SQB * (C0_SQB + C1_SQB * (FI_DQ933 * I_DQ933) + C2_SQB * (FI_DQ933 * I_DQ933)^2 + C3_SQB * (FI_DQ933 * I_DQ933)^3) * E_LIGHT / (1E+09 * L_SQB * E_MOMENTUM);
G_DQDA01 = F_DQDA01 * F_QQK * (C0_QQK + C1_QQK * (FI_DQDA01 * I_DQDA01) + C2_QQK * (FI_DQDA01 * I_DQDA01)^2 + C3_QQK * (FI_DQDA01 * I_DQDA01)^3) * E_LIGHT / (1E+09 * L_QQK * E_MOMENTUM);
G_DQDA02 = F_DQDA02 * F_QQK * (C0_QQK + C1_QQK * (FI_DQDA02 * I_DQDA02) + C2_QQK * (FI_DQDA02 * I_DQDA02)^2 + C3_QQK * (FI_DQDA02 * I_DQDA02)^3) * E_LIGHT / (1E+09 * L_QQK * E_MOMENTUM);

// Tune ramping quadrupole magnet normalized gradients. [1/m^2]
G_DQX301 = F_DQX301 * F_CQA * (C0_CQA + C1_CQA * (FI_DQX * I_DQX) + C2_CQA * (FI_DQX * I_DQX)^2 + C3_CQA * (FI_DQX * I_DQX)^3) * E_LIGHT / (1E+09 * L_CQA * E_MOMENTUM);

// Main dipole magnet bend angle deviations. [rad]
H_DISEP = F_DISEP * F_MSE * C1_MSE * (FI_DISEP * I_DISEP) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DKK3IA = F_DKK3IA * F_DKB * C1_DKB * (FI_DKK3I * I_DKK3I) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DKK3IB = F_DKK3IB * F_DKB * C1_DKB * (FI_DKK3I * I_DKK3I) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DESSA = F_DESSA * F_DSA * C1_DSA * (FI_DESSA * I_DESSA) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DESSB = F_DESSB * F_DSB * C1_DSB * (FI_DESSB * I_DESSB) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DELAM = F_DELAM * F_MLG * C1_MLG * (FI_DELAM * I_DELAM) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DECMAG = F_DECMAG * F_MSDA * C1_MSDA * (FI_DECMAG * I_DECMAG) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DV901 = F_DV901 * F_EDWA * C1_EDWA * (FI_DV901 * I_DV901) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DV906 = F_DV906 * F_MDC * C1_MDC * (FI_DV906 * I_DV906) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DV907 = F_DV907 * F_MDC * C1_MDC * (FI_DV907 * I_DV907) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH910 = F_DH910 * F_SDFW * C1_SDFW * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH911 = F_DH911 * F_SDFW * C1_SDFW * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH912 = F_DH912 * F_SDFB * C1_SDFB * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH916 = F_DH916 * F_SDFB * C1_SDFB * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH917 = F_DH917 * F_SDFW * C1_SDFW * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DH918 = F_DH918 * F_SDFW * C1_SDFW * (FI_DH910 * I_DH910) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929A = F_DAC929A * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929B = F_DAC929B * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929C = F_DAC929C * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929D = F_DAC929D * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929E = F_DAC929E * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DAC929F = F_DAC929F * F_ACD * C1_ACD * (FI_DAC929 * I_DAC929) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHDA01 = F_DHDA01 * F_SDC * C1_SDC * (FI_DHDA01 * I_DHDA01) * E_LIGHT / (1E+09 * E_MOMENTUM);

// Trim dipole magnet bend angle deviations. [rad]
H_DHT301 = F_DHT301 * F_NDB * C1_NDB * (FI_DHT301 * I_DHT301 / 2) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT900 = F_DHT900 * F_NDA * C1_NDA * (FI_DHT900 * I_DHT900) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT901 = F_DHT901 * F_NDB * C1_NDB * (FI_DHT901 * I_DHT901) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT905 = F_DHT905 * F_NDB * C1_NDB * (FI_DHT905 * I_DHT905) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT906 = F_DHT906 * F_NDB * C1_NDB * (FI_DHT906 * I_DHT906) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT909 = F_DVT909 * F_NDA * C1_NDA * (FI_DVT909 * I_DVT909) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT909 = F_DHT909 * F_NDA * C1_NDA * (FI_DHT909 * I_DHT909) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT911 = F_DVT911 * F_NDA * C1_NDA * (FI_DVT911 * I_DVT911) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT914 = F_DHT914 * F_NDA * C1_NDA * (FI_DHT914 * I_DHT914) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT914 = F_DVT914 * F_NDA * C1_NDA * (FI_DVT914 * I_DVT914) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT919 = F_DHT919 * F_NDA * C1_NDA * (FI_DHT919 * I_DHT919) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT919 = F_DVT919 * F_NDA * C1_NDA * (FI_DVT919 * I_DVT919) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT921 = F_DVT921 * F_NDA * C1_NDA * (FI_DVT921 * I_DVT921) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT927 = F_DHT927 * F_NDA * C1_NDA * (FI_DHT927 * I_DHT927) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT927 = F_DVT927 * F_NDA * C1_NDA * (FI_DVT927 * I_DVT927) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT928 = F_DHT928 * F_NDB * C1_NDB * (FI_DHT928 * I_DHT928) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DHT930 = F_DHT930 * F_NDB * C1_NDB * (FI_DHT930 * I_DHT930) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT930 = F_DVT930 * F_NDB * C1_NDB * (FI_DVT930 * I_DVT930) * E_LIGHT / (1E+09 * E_MOMENTUM);
H_DVT933 = F_DVT933 * F_NDA * C1_NDA * (FI_DVT933 * I_DVT933) * E_LIGHT / (1E+09 * E_MOMENTUM);

//##############################################################################
// Misc Functions
//##############################################################################

// Relative momentum deviation. [1]
E_DPD = (E_DRFD / E_DRFN) / ((E_MASS)^2 / ((E_MOMENTUM)^2 + (E_MASS)^2) - (E_MASS)^2 / ((E_DPT)^2 + (E_MASS)^2));

// Main quadrupole magnet bend angles. [rad]
A_DQ203 = SQRT((AX_DQ203)^2 + (AY_DQ203)^2);
A_DQ204 = SQRT((AX_DQ204)^2 + (AY_DQ204)^2);
A_DQ205 = SQRT((AX_DQ205)^2 + (AY_DQ205)^2);

